generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A storefront (tenant) served by this app. Every request belongs to the
/// store owning its host (StoreDomain); stores come from the seed and the
/// panel, never from code. See lib/stores.ts.
model Store {
  id            String                 @id @default(cuid())
  /// Stable handle for seeds and panel URLs.
  key           String                 @unique
  name          String
  /// Served at unprefixed URLs; the other locales carry a prefix.
  defaultLocale String                 @default("en")
  /// Every published locale, including defaultLocale.
  locales       String[]               @default(["en"])
  /// Serves hosts no domain matches (localhost, the server IP). Keep exactly one.
  isDefault     Boolean                @default(false)
  domains       StoreDomain[]
  settings      StoreSetting[]
  themes        Theme[]
  extensions    Extension[]
  posts         Post[]
  categories    Category[]
  tags          Tag[]
  inquiries     ContactInquiry[]
  reviews       ProductReview[]
  media         MediaAsset[]
  subscribers   NewsletterSubscriber[]
  billingPlans  BillingPlan[]
  releases      ProductRelease[]
  pageViews     PageViewDaily[]
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
}

model StoreDomain {
  id        String   @id @default(cuid())
  /// Hostname without protocol or port.
  host      String   @unique
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  /// Canonical host for the store's links; the others are aliases (www).
  primary   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([storeId])
}

model User {
  id              String       @id
  name            String
  email           String       @unique
  emailVerified   Boolean      @default(false)
  termsVersion    String?
  privacyVersion  String?
  termsAcceptedAt DateTime?
  accountLocale   String       @default("en")
  image           String?
  /// "admin" grants panel administration; "user" is the default account level.
  /// Additional levels (editor, reviewer) can be added without a schema change.
  role            String       @default("user")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  sessions        Session[]
  accounts        Account[]
  uploads         MediaAsset[]
  posts           Post[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model ContactInquiry {
  id           String    @id @default(cuid())
  storeId      String
  store        Store     @relation(fields: [storeId], references: [id])
  name         String
  email        String
  agency       String
  typo3Version String
  license      String
  message      String
  emailSent    Boolean   @default(false)
  /// Set the first time the message is opened in the panel inbox; null means unread.
  readAt       DateTime?
  /// Set once the message is archived out of the active inbox; null keeps it listed.
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([storeId, createdAt])
}

/// Guest review on a static-site product page (theme-<productSlug>). Every
/// review starts "pending" and only "approved" rows are shown publicly or
/// counted in the star rating; moderation happens in /panel/reviews.
model ProductReview {
  id          String     @id @default(cuid())
  storeId     String
  store       Store      @relation(fields: [storeId], references: [id])
  /// The reviewed product: exactly one of themeId / extensionId is set.
  themeId     String?
  theme       Theme?     @relation(fields: [themeId], references: [id], onDelete: Cascade)
  extensionId String?
  extension   Extension? @relation(fields: [extensionId], references: [id], onDelete: Cascade)
  /// The product's slug when the review was written, kept for reference.
  productSlug String
  authorName  String
  /// Never shown publicly.
  authorEmail String
  rating      Int
  body        String
  /// pending | approved | rejected
  status      String     @default("pending")
  /// Site locale the review was written on (de | en | tr).
  locale      String     @default("de")
  /// Client-generated UUID so a double submit cannot create two rows.
  requestKey  String     @unique
  moderatedAt DateTime?
  createdAt   DateTime   @default(now())

  @@index([themeId, status, createdAt])
  @@index([extensionId, status, createdAt])
  @@index([storeId, status, createdAt])
  @@index([authorEmail, createdAt])
}

/// Uploads handled by UploadThing; the row is written by onUploadComplete.
model MediaAsset {
  id               String             @id @default(cuid())
  storeId          String
  store            Store              @relation(fields: [storeId], references: [id])
  key              String
  url              String
  fileName         String
  fileSize         Int
  mimeType         String
  alt              String?
  width            Int?
  height           Int?
  uploadedById     String?
  uploadedBy       User?              @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  themeCovers      Theme[]            @relation("ThemeCover")
  extensionCovers  Extension[]        @relation("ExtensionCover")
  postCovers       Post[]             @relation("PostCover")
  themeGallery     ThemeGallery[]
  extensionGallery ExtensionGallery[]
  createdAt        DateTime           @default(now())

  @@unique([storeId, key])
  @@index([storeId, createdAt])
  @@map("MediaAsset")
}

model Theme {
  id            String           @id @default(cuid())
  storeId       String
  store         Store            @relation(fields: [storeId], references: [id])
  slug          String
  name          String
  summary       String
  compliance    Json             @default("{}")
  /// Tiptap HTML output.
  description   String
  status        String           @default("concept")
  industry      String
  versionTarget String
  /// Indicative price in whole euros shown on the catalogue card: 0 = free, null = not set yet.
  price         Int?
  /// Order on the public catalogue (home page and /themes), ascending.
  position      Int              @default(0)
  /// Detail page (/theme/<slug>) hero kicker, e.g. "The featured concept". Empty = industry.
  tagline       String?
  /// Detail page hero paragraph. Empty = summary.
  intro         String?
  /// Short lines listed under the buy panel buttons.
  highlights    String[]         @default([])
  /// Compatibility tab rows: [{ area, target, status }].
  compatibility Json             @default("[]")
  /// Licence options for the buy panel: [{ name, price }] in whole euros. Empty = `price` only.
  licences      Json             @default("[]")
  /// Primary buy panel button. Empty = "Ask about <name>" linking to /contact.
  ctaLabel      String?
  ctaUrl        String?
  /// Optional "View visual demo" button.
  demoUrl       String?
  coverId       String?
  cover         MediaAsset?      @relation("ThemeCover", fields: [coverId], references: [id], onDelete: SetNull)
  gallery       ThemeGallery[]
  changelog     ChangelogEntry[]
  reviews       ProductReview[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([storeId, slug])
  @@index([storeId, status])
  @@map("Theme")
}

model ThemeGallery {
  id       String     @id @default(cuid())
  themeId  String
  theme    Theme      @relation(fields: [themeId], references: [id], onDelete: Cascade)
  assetId  String
  asset    MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  position Int        @default(0)

  @@unique([themeId, assetId])
  @@index([themeId, position])
  @@map("ThemeGallery")
}

model Extension {
  id            String             @id @default(cuid())
  storeId       String
  store         Store              @relation(fields: [storeId], references: [id])
  slug          String
  name          String
  summary       String
  compliance    Json               @default("{}")
  /// Tiptap HTML output.
  description   String
  status        String             @default("concept")
  /// Order on the public catalogue (home page and /extensions), ascending.
  position      Int                @default(0)
  /// Detail page (/extension/<slug>) fields; see Theme for their meaning.
  tagline       String?
  intro         String?
  highlights    String[]           @default([])
  compatibility Json               @default("[]")
  ctaLabel      String?
  ctaUrl        String?
  demoUrl       String?
  coverId       String?
  cover         MediaAsset?        @relation("ExtensionCover", fields: [coverId], references: [id], onDelete: SetNull)
  gallery       ExtensionGallery[]
  changelog     ChangelogEntry[]
  reviews       ProductReview[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([storeId, slug])
  @@index([storeId, status])
  @@map("Extension")
}

/// A release note for exactly one theme or one extension, written under /panel/changelog.
model ChangelogEntry {
  id          String     @id @default(cuid())
  themeId     String?
  theme       Theme?     @relation(fields: [themeId], references: [id], onDelete: Cascade)
  extensionId String?
  extension   Extension? @relation(fields: [extensionId], references: [id], onDelete: Cascade)
  version     String
  title       String
  /// Release date; the detail page shows month and year.
  releasedAt  DateTime
  /// [{ kind: "new" | "improved" | "fixed", text }]
  changes     Json       @default("[]")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([themeId, releasedAt])
  @@index([extensionId, releasedAt])
  @@index([createdAt])
  @@map("ChangelogEntry")
}

model ExtensionGallery {
  id          String     @id @default(cuid())
  extensionId String
  extension   Extension  @relation(fields: [extensionId], references: [id], onDelete: Cascade)
  assetId     String
  asset       MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  position    Int        @default(0)

  @@unique([extensionId, assetId])
  @@index([extensionId, position])
  @@map("ExtensionGallery")
}

/// Blog post written in the panel. `excerpt` doubles as the SEO meta
/// description (max 160 chars) and the list teaser.
model Post {
  id          String        @id @default(cuid())
  storeId     String
  store       Store         @relation(fields: [storeId], references: [id])
  title       String
  slug        String
  excerpt     String        @default("")
  /// Tiptap HTML output.
  content     String        @default("")
  coverId     String?
  cover       MediaAsset?   @relation("PostCover", fields: [coverId], references: [id], onDelete: SetNull)
  /// draft | scheduled | published
  status      String        @default("draft")
  scheduledAt DateTime?
  featured    Boolean       @default(false)
  readingTime Int           @default(1)
  publishedAt DateTime?
  authorId    String?
  author      User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  categoryId  String?
  category    Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags        PostTag[]
  comments    PostComment[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([storeId, slug])
  @@index([storeId, status])
  @@index([categoryId])
  @@index([createdAt])
  @@map("Post")
}

/// Moderated blog discussion. Email and pending/rejected messages remain private.
model PostComment {
  id            String        @id @default(cuid())
  postId        String
  post          Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  parentId      String?
  parent        PostComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies       PostComment[] @relation("CommentReplies")
  authorName    String
  authorEmail   String
  body          String
  /// pending | approved | rejected
  status        String        @default("pending")
  locale        String        @default("en")
  requestKey    String        @unique
  moderatedAt   DateTime?
  /// pending | checking | passed | flagged | error | unavailable | not_checked; advisory only
  aiStatus      String        @default("pending")
  aiNote        String?
  aiModel       String?
  aiCheckedAt   DateTime?
  aiReviewToken String?
  createdAt     DateTime      @default(now())

  @@index([postId, status, createdAt])
  @@index([parentId, status, createdAt])
  @@index([status, createdAt])
  @@index([authorEmail, createdAt])
}

model Category {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id])
  name        String
  slug        String
  description String?
  color       String   @default("#4353e8")
  posts       Post[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([storeId, slug])
  @@map("Category")
}

model Tag {
  id        String    @id @default(cuid())
  storeId   String
  store     Store     @relation(fields: [storeId], references: [id])
  name      String
  slug      String
  posts     PostTag[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([storeId, slug])
  @@map("Tag")
}

model PostTag {
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  tagId  String
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
  @@map("PostTag")
}

/// Install-wide settings shared by every store: only the panel's own
/// security (private entry path). Values are stored as strings.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Per-store settings edited from the panel settings page: `<group>.<field>`
/// rows holding JSON (lib/settings-store.ts). Each store keeps its own.
model StoreSetting {
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  key       String
  value     String
  updatedAt DateTime @updatedAt

  @@id([storeId, key])
}

/// Footer newsletter signup. Emails are unique so resubscribing simply
/// refreshes the stored name instead of creating a second row.
model NewsletterSubscriber {
  id                    String    @id @default(cuid())
  storeId               String
  store                 Store     @relation(fields: [storeId], references: [id])
  email                 String
  firstName             String
  lastName              String
  source                String    @default("footer")
  locale                String    @default("en")
  consentVersion        String?
  confirmedAt           DateTime?
  unsubscribedAt        DateTime?
  confirmationTokenHash String?   @unique
  confirmationExpiresAt DateTime?
  confirmationSentAt    DateTime?
  unsubscribeTokenHash  String?   @unique
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([storeId, email, source])
}

/// Kept outside content backups: billing identity and access must never roll back with page content.
model BillingPlan {
  id                 String   @id @default(cuid())
  storeId            String
  store              Store    @relation(fields: [storeId], references: [id])
  kind               String
  productSlug        String
  name               String
  priceCents         Int
  currency           String   @default("EUR")
  installations      Int      @default(1)
  creemTestProductId String?  @unique
  creemLiveProductId String?  @unique
  enabled            Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([storeId, kind, productSlug])
}

model CheckoutAttempt {
  id             String   @id @default(cuid())
  userId         String
  planId         String
  creemProductId String
  mode           String
  termsVersion   String
  privacyVersion String
  acceptedAt     DateTime @default(now())
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
}

model ProductSubscription {
  id                  String   @id @default(cuid())
  userId              String
  planId              String
  creemSubscriptionId String   @unique
  creemCustomerId     String
  mode                String
  status              String
  currentPeriodStart  DateTime
  currentPeriodEnd    DateTime
  providerUpdatedAt   DateTime
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([userId, mode])
}

model ProductRelease {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id])
  kind        String
  productSlug String
  version     String
  fileKey     String   @unique
  fileName    String
  codeLicense String
  createdAt   DateTime @default(now())

  @@unique([storeId, kind, productSlug, version])
}

model PaymentEvent {
  id          String   @id
  type        String
  mode        String
  processedAt DateTime @default(now())
}

/// Daily page-view counters for the public site, one row per slug per day.
/// Written fire-and-forget by the legacy page route and summarized on the
/// panel overview.
model PageViewDaily {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  date      DateTime @db.Date
  slug      String
  views     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([storeId, date, slug])
}
