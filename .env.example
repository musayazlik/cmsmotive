# Dev/start server port (read by scripts/next.mjs; Next itself ignores PORT in .env)
PORT=3000

# Required: local or hosted PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cmsmotive?schema=public"

# Better Auth
# Use a long random value in production.
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
BETTER_AUTH_URL="http://localhost:3000"

# Store domains live in the database (Store / StoreDomain, seeded by prisma/seed-stores.ts);
# canonical URLs, sitemap, emails and auth follow the request's store (lib/stores.ts).
# Locally, open http://<store-key>.localhost:<PORT> (e.g. the seed keys) to preview a store.

# UploadThing (required for media uploads)
UPLOADTHING_TOKEN=""

# Default product ZIP provider for stores without a saved choice in Settings → Media.
# Settings also select image/video providers independently. UploadThing private ZIPs require a paid tier.
# Existing releases continue to use the provider recorded with each file.
PACKAGE_STORAGE_PROVIDER="r2"
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="cmsmotive-packages"
# Exact panel origins, comma-separated, no trailing slash. Adjust local port to PORT above.
R2_CORS_ORIGINS="http://localhost:3000,http://global.localhost:3000,http://typo3.localhost:3000,https://cmsmotive.com,https://www.cmsmotive.com,https://cmsmotive.de,https://www.cmsmotive.de"
# R2 receipts use the existing BETTER_AUTH_SECRET (at least 32 characters).

# Plunk email delivery (required for verification, password reset, and contact mail)
PLUNK_SECRET_KEY=""
PLUNK_FROM_EMAIL=""
PLUNK_CONTACT_TO_EMAIL="info@cmsmotive.de"

# Scheduled notification job (release announcements, renewal reminders, queued mail).
# Call POST /api/cron/notifications with "Authorization: Bearer <this value>" every 15-60 minutes.
# Generate one with: openssl rand -hex 32
CRON_SECRET=""

# OpenRouter (optional; enables AI features in the admin panel)
OPENROUTER_API_KEY=""

# Optional seed overrides. Development defaults are used when omitted.
SEED_SUPERADMIN_NAME="CMSMotive Superadmin"
SEED_SUPERADMIN_EMAIL="superadmin@cmsmotive.de"
SEED_SUPERADMIN_PASSWORD=""
SEED_ADMIN_NAME="CMSMotive Admin"
SEED_ADMIN_EMAIL="admin@cmsmotive.de"
SEED_ADMIN_PASSWORD=""
SEED_USER_NAME="CMSMotive User"
SEED_USER_EMAIL="user@cmsmotive.de"
SEED_USER_PASSWORD=""

# Google reCAPTCHA v3 (guest product reviews). Reviews cannot be submitted
# without both keys. Keys: https://www.google.com/recaptcha/admin
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""

# Creem: test and live products/keys are separate. Start in test mode.
# Never expose these keys through NEXT_PUBLIC variables.
CREEM_MODE="test"
CREEM_API_KEY=""
CREEM_WEBHOOK_SECRET=""
# Local CLI only: reuse the endpoint whose signing secret is configured above.
# Without this, `creem listen` creates a new endpoint and signing secret each run.
CREEM_CLI_WEBHOOK_ID=""

# Optional Google sign-in: OAuth web client. Callback is /api/auth/callback/google.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
