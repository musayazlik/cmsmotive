{
  "name": "cmsmotive",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "start:prod": "prisma migrate deploy && next start",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "prisma db seed",
    "db:seed:catalog": "tsx prisma/seed-catalog.ts",
    "mcp": "tsx mcp/stdio.ts",
    "telegram:poll": "tsx telegram/poll.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:admin-access": "tsx --test tests/admin-access.test.ts",
    "test:backup": "tsx --test tests/backup.test.ts",
    "test:backup:db": "tsx --test tests/backup.integration.test.ts",
    "test:commerce": "tsx --test tests/billing-access.test.ts tests/purchase-flow.test.ts",
    "test:commerce:db": "tsx --test tests/commerce.integration.test.ts tests/checkout.integration.test.ts",
    "test:membership": "tsx --test tests/site-account-menu.test.ts",
    "test:membership:db": "tsx --test tests/membership.integration.test.ts",
    "test:blog-comments": "tsx --test tests/blog-comments.test.ts",
    "test:blog-comments:db": "tsx --test tests/blog-comments.integration.test.ts",
    "test:comment-ai": "tsx --test tests/comment-ai.test.ts",
    "test:comment-ai:db": "tsx --test tests/comment-ai.integration.test.ts",
    "i18n:check": "tsx scripts/i18n-legacy.ts",
    "creem:webhook": "creem listen --forward-to http://localhost:3000/api/webhooks"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "@tiptap/extension-highlight": "^3.31.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-list": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/extension-subscript": "^3.31.3",
    "@tiptap/extension-superscript": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/extension-text-align": "^3.31.3",
    "@tiptap/extension-text-style": "^3.31.3",
    "@tiptap/extension-typography": "^3.31.3",
    "@tiptap/extension-youtube": "^3.31.3",
    "@tiptap/extensions": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@uploadthing/react": "^7.3.3",
    "better-auth": "^1.4.0",
    "dotenv": "^17.0.0",
    "marked": "^18.0.14",
    "next": "^16.0.0",
    "pg": "^8.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-email": "^6.11.0",
    "uploadthing": "^7.7.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.2",
    "prisma": "^7.0.0",
    "raw-loader": "^4.0.2",
    "tsx": "^4.23.15",
    "typescript": "^5.0.0"
  }
}
