generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A storefront (tenant) served by this app. Every request belongs to the
/// store owning its host (StoreDomain); stores come from the seed and the
/// panel, never from code. See lib/stores.ts.
model Store {
  id            String                 @id @default(cuid())
  /// Stable handle for seeds and panel URLs.
  key           String                 @unique
  name          String
  /// Served at unprefixed URLs; the other locales carry a prefix.
  defaultLocale String                 @default("en")
  /// Every published locale, including defaultLocale.
  locales       String[]               @default(["en"])
  /// Serves hosts no domain matches (localhost, the server IP). Keep exactly one.
  isDefault     Boolean                @default(false)
  domains       StoreDomain[]
  settings      StoreSetting[]
  products      Product[]
  customers     Customer[]
  orders        Order[]
  subscriptions Subscription[]
  entitlements  Entitlement[]
  transactions  Transaction[]
  posts         Post[]
  categories    Category[]
  tags          Tag[]
  inquiries     ContactInquiry[]
  reviews       ProductReview[]
  media         MediaAsset[]
  subscribers   NewsletterSubscriber[]
  pageViews     PageViewDaily[]
  activities    AssistantActivity[]
  members       StoreMember[]
  notifications Notification[]
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
}

/// A shared account's access to one store.
model StoreMember {
  storeId   String
  userId    String
  /// Store-local permission: admin | user. Superadmin remains installation-wide.
  role      String   @default("user")
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([storeId, userId])
  @@index([userId])
}

/// Operational summaries only; never store prompts, credentials or tool arguments.
model AssistantActivity {
  id         String    @id @default(cuid())
  storeId    String
  store      Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  source     String
  title      String
  status     String    @default("running")
  detail     String
  steps      Json      @default("[]")
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  finishedAt DateTime?

  @@index([storeId, status, expiresAt])
  @@index([storeId, createdAt])
}

model StoreDomain {
  id        String   @id @default(cuid())
  /// Hostname without protocol or port.
  host      String   @unique
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  /// Canonical host for the store's links; the others are aliases (www).
  primary   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([storeId])
}

model User {
  id                     String                  @id
  name                   String
  email                  String                  @unique
  emailVerified          Boolean                 @default(false)
  termsVersion           String?
  privacyVersion         String?
  termsAcceptedAt        DateTime?
  accountLocale          String                  @default("en")
  image                  String?
  /// "admin" grants panel administration; "user" is the default account level.
  /// Additional levels (editor, reviewer) can be added without a schema change.
  role                   String                  @default("user")
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  sessions               Session[]
  accounts               Account[]
  uploads                MediaAsset[]
  posts                  Post[]
  customers              Customer[]
  storeMemberships       StoreMember[]
  notifications          Notification[]
  notificationPreference NotificationPreference?

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model ContactInquiry {
  id           String    @id @default(cuid())
  storeId      String
  store        Store     @relation(fields: [storeId], references: [id])
  name         String
  email        String
  agency       String
  typo3Version String
  license      String
  message      String
  emailSent    Boolean   @default(false)
  /// Set the first time the message is opened in the panel inbox; null means unread.
  readAt       DateTime?
  /// Set once the message is archived out of the active inbox; null keeps it listed.
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([storeId, createdAt])
}

/// Guest review on a static-site product page (theme-<productSlug>). Every
/// review starts "pending" and only "approved" rows are shown publicly or
/// counted in the star rating; moderation happens in /panel/reviews.
model ProductReview {
  id          String    @id @default(cuid())
  storeId     String
  store       Store     @relation(fields: [storeId], references: [id])
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// The product's slug when the review was written, kept for reference.
  productSlug String
  authorName  String
  /// Never shown publicly.
  authorEmail String
  rating      Int
  body        String
  /// pending | approved | rejected
  status      String    @default("pending")
  /// Site locale the review was written on (de | en | tr).
  locale      String    @default("de")
  /// Client-generated UUID so a double submit cannot create two rows.
  requestKey  String    @unique
  moderatedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([productId, status, createdAt])
  @@index([storeId, status, createdAt])
  @@index([authorEmail, createdAt])
}

/// Uploads handled by UploadThing; the row is written by onUploadComplete.
model MediaAsset {
  id             String           @id @default(cuid())
  storeId        String
  store          Store            @relation(fields: [storeId], references: [id])
  key            String
  url            String
  fileName       String
  fileSize       Int
  mimeType       String
  alt            String?
  width          Int?
  height         Int?
  uploadedById   String?
  uploadedBy     User?            @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  productCovers  Product[]        @relation("ProductCover")
  postCovers     Post[]           @relation("PostCover")
  productGallery ProductGallery[]
  createdAt      DateTime         @default(now())

  @@unique([storeId, key])
  @@index([storeId, createdAt])
  @@map("MediaAsset")
}

/// A release note for one product, written under /panel/changelog.
model ChangelogEntry {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  version    String
  title      String
  /// Release date; the detail page shows month and year.
  releasedAt DateTime
  /// [{ kind: "new" | "improved" | "fixed", text }]
  changes    Json     @default("[]")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([productId, releasedAt])
  @@index([createdAt])
  @@map("ChangelogEntry")
}

/// Blog post written in the panel. `excerpt` doubles as the SEO meta
/// description (max 160 chars) and the list teaser.
model Post {
  id          String        @id @default(cuid())
  storeId     String
  store       Store         @relation(fields: [storeId], references: [id])
  title       String
  slug        String
  excerpt     String        @default("")
  /// Tiptap HTML output.
  content     String        @default("")
  coverId     String?
  cover       MediaAsset?   @relation("PostCover", fields: [coverId], references: [id], onDelete: SetNull)
  /// draft | scheduled | published
  status      String        @default("draft")
  scheduledAt DateTime?
  featured    Boolean       @default(false)
  readingTime Int           @default(1)
  publishedAt DateTime?
  authorId    String?
  author      User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  categoryId  String?
  category    Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags        PostTag[]
  comments    PostComment[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([storeId, slug])
  @@index([storeId, status])
  @@index([categoryId])
  @@index([createdAt])
  @@map("Post")
}

/// Moderated blog discussion. Email and pending/rejected messages remain private.
model PostComment {
  id            String        @id @default(cuid())
  postId        String
  post          Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  parentId      String?
  parent        PostComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies       PostComment[] @relation("CommentReplies")
  authorName    String
  authorEmail   String
  body          String
  /// pending | approved | rejected
  status        String        @default("pending")
  locale        String        @default("en")
  requestKey    String        @unique
  moderatedAt   DateTime?
  /// pending | checking | passed | flagged | error | unavailable | not_checked; advisory only
  aiStatus      String        @default("pending")
  aiNote        String?
  aiModel       String?
  aiCheckedAt   DateTime?
  aiReviewToken String?
  createdAt     DateTime      @default(now())

  @@index([postId, status, createdAt])
  @@index([parentId, status, createdAt])
  @@index([status, createdAt])
  @@index([authorEmail, createdAt])
}

model Category {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id])
  name        String
  slug        String
  description String?
  color       String   @default("#4353e8")
  posts       Post[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([storeId, slug])
  @@map("Category")
}

model Tag {
  id        String    @id @default(cuid())
  storeId   String
  store     Store     @relation(fields: [storeId], references: [id])
  name      String
  slug      String
  posts     PostTag[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([storeId, slug])
  @@map("Tag")
}

model PostTag {
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  tagId  String
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
  @@map("PostTag")
}

/// Install-wide settings shared by every store: only the panel's own
/// security (private entry path). Values are stored as strings.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Per-store settings edited from the panel settings page: `<group>.<field>`
/// rows holding JSON (lib/settings-store.ts). Each store keeps its own.
model StoreSetting {
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  key       String
  value     String
  updatedAt DateTime @updatedAt

  @@id([storeId, key])
}

/// Footer newsletter signup. Emails are unique so resubscribing simply
/// refreshes the stored name instead of creating a second row.
model NewsletterSubscriber {
  id                    String    @id @default(cuid())
  storeId               String
  store                 Store     @relation(fields: [storeId], references: [id])
  email                 String
  firstName             String
  lastName              String
  source                String    @default("footer")
  locale                String    @default("en")
  consentVersion        String?
  confirmedAt           DateTime?
  unsubscribedAt        DateTime?
  confirmationTokenHash String?   @unique
  confirmationExpiresAt DateTime?
  confirmationSentAt    DateTime?
  unsubscribeTokenHash  String?   @unique
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([storeId, email, source])
}

/// A kind of product (theme, extension, CMS, starter kit …). Managed in the
/// panel and shared by every store; code never names one.
model ProductType {
  id          String    @id @default(cuid())
  /// Stable handle used in URLs filters and catalogue markers (`type=<key>`).
  key         String    @unique
  name        String
  pluralName  String
  description String?
  /// Public listing page for this type, e.g. "/themes"; empty = /products?type=<key>.
  listPath    String?
  position    Int       @default(0)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

/// Anything the catalogue shows and sells. Owned by and listed in one store;
/// "copy to store" duplicates it into another.
model Product {
  id               String           @id @default(cuid())
  storeId          String
  store            Store            @relation(fields: [storeId], references: [id])
  typeId           String
  type             ProductType      @relation(fields: [typeId], references: [id])
  /// Public URL /products/<slug> on its store's domain.
  slug             String
  name             String
  summary          String
  /// Tiptap HTML output.
  description      String
  /// draft (hidden) | preview (shown, not buyable) | published (buyable)
  status           String           @default("draft")
  /// Optional progress note on cards and the detail page, e.g. "In development".
  badge            String?
  /// Order on the store's catalogue, ascending.
  position         Int              @default(0)
  /// Card kicker such as an industry; empty = the type name.
  category         String?
  /// Stacks and versions it targets, e.g. ["Next.js 16", "PostgreSQL"].
  technologies     String[]         @default([])
  compliance       Json             @default("{}")
  /// Detail page hero kicker; empty = category.
  tagline          String?
  /// Detail page hero paragraph; empty = summary.
  intro            String?
  /// Short lines listed under the buy panel.
  highlights       String[]         @default([])
  /// Compatibility tab rows: [{ area, target, status }].
  compatibility    Json             @default("[]")
  /// Primary buy panel button when nothing can be bought yet; empty = "Ask about <name>".
  ctaLabel         String?
  ctaUrl           String?
  demoUrl          String?
  /// Delivery: issue our own licence key with every purchase (activations = the price's installations).
  issueLicenseKeys Boolean          @default(false)
  /// Delivery: plain-text note buyers see in their account next to the downloads.
  deliveryNote     String?
  coverId          String?
  cover            MediaAsset?      @relation("ProductCover", fields: [coverId], references: [id], onDelete: SetNull)
  gallery          ProductGallery[]
  prices           Price[]
  releases         ProductRelease[]
  changelog        ChangelogEntry[]
  reviews          ProductReview[]
  orders           Order[]
  subscriptions    Subscription[]
  entitlements     Entitlement[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([storeId, slug])
  @@index([storeId, status, position])
  @@index([typeId])
}

model ProductGallery {
  id        String     @id @default(cuid())
  productId String
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  assetId   String
  asset     MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  position  Int        @default(0)

  @@unique([productId, assetId])
  @@index([productId, position])
}

/// A private ZIP package of one product version (UploadThing or Cloudflare R2).
model ProductRelease {
  id          String    @id @default(cuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  version     String
  /// UploadThing key or r2://bucket/packages/... reference; never a public URL.
  fileKey     String    @unique
  fileName    String
  codeLicense String
  /// When buyers were told about this version (lib/notifications.ts); null = still to announce.
  notifiedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@unique([productId, version])
}

/// One way to buy a product in one store. Maps 1:1 to a Creem product, which
/// carries exactly one price, currency and billing period.
model Price {
  id                 String            @id @default(cuid())
  productId          String
  product            Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Buy panel label, e.g. "Single site", "Agency".
  name               String
  /// onetime | recurring (Creem billing_type)
  billingType        String
  /// month | quarter | half-year | year; recurring only (Creem billing_period every-…)
  interval           String?
  amountCents        Int
  currency           String            @default("EUR")
  /// inclusive | exclusive (Creem tax_mode)
  taxMode            String            @default("inclusive")
  /// One-time purchases: months of new releases included; null = lifetime. Ignored for subscriptions.
  updatesMonths      Int?
  /// Installations (or seats) covered by support and licence keys.
  seats              Int               @default(1)
  /// Bullet lines shown with the price.
  features           String[]          @default([])
  creemTestProductId String?           @unique
  creemLiveProductId String?           @unique
  /// On sale: has a matching Creem product for the current payment mode. Off = shown as an indicative "from" price.
  enabled            Boolean           @default(false)
  position           Int               @default(0)
  checkouts          CheckoutAttempt[]
  orders             Order[]
  subscriptions      Subscription[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([productId, position])
}

/// A buyer as Creem knows them, per store and payment mode. Survives the
/// deletion of the user account, so financial history stays intact.
model Customer {
  id              String         @id @default(cuid())
  storeId         String
  store           Store          @relation(fields: [storeId], references: [id])
  userId          String?
  user            User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// test | prod
  mode            String
  creemCustomerId String
  email           String
  name            String?
  country         String?
  orders          Order[]
  subscriptions   Subscription[]
  entitlements    Entitlement[]
  transactions    Transaction[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([storeId, creemCustomerId])
  @@index([storeId, userId, mode])
  @@index([storeId, email])
}

/// The consent and intent recorded before redirecting to Creem; the webhook matches it back.
model CheckoutAttempt {
  id             String   @id @default(cuid())
  userId         String
  storeId        String
  priceId        String
  price          Price    @relation(fields: [priceId], references: [id], onDelete: Cascade)
  creemProductId String
  mode           String
  termsVersion   String
  privacyVersion String
  acceptedAt     DateTime @default(now())
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
}

/// A completed Creem checkout: a one-time purchase or the first payment of a subscription.
model Order {
  id                String        @id @default(cuid())
  storeId           String
  store             Store         @relation(fields: [storeId], references: [id])
  customerId        String
  customer          Customer      @relation(fields: [customerId], references: [id])
  productId         String
  product           Product       @relation(fields: [productId], references: [id])
  priceId           String
  price             Price         @relation(fields: [priceId], references: [id])
  checkoutAttemptId String?       @unique
  creemOrderId      String        @unique
  creemCheckoutId   String?
  mode              String
  /// onetime | recurring
  type              String
  /// paid | refunded | partially_refunded | disputed
  status            String
  amountCents       Int
  currency          String
  subscriptionId    String?
  subscription      Subscription? @relation(fields: [subscriptionId], references: [id])
  entitlement       Entitlement?
  transactions      Transaction[]
  /// When Creem created the order.
  placedAt          DateTime
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([storeId, placedAt])
  @@index([customerId])
}

/// A Creem subscription, reconciled from its API on every webhook.
model Subscription {
  id                  String        @id @default(cuid())
  storeId             String
  store               Store         @relation(fields: [storeId], references: [id])
  customerId          String
  customer            Customer      @relation(fields: [customerId], references: [id])
  productId           String
  product             Product       @relation(fields: [productId], references: [id])
  priceId             String
  price               Price         @relation(fields: [priceId], references: [id])
  creemSubscriptionId String        @unique
  mode                String
  /// Creem status (active, scheduled_cancel, canceled, expired, past_due, unpaid, paused, trialing)
  /// or the local refunded / disputed.
  status              String
  currentPeriodStart  DateTime
  currentPeriodEnd    DateTime
  canceledAt          DateTime?
  providerUpdatedAt   DateTime
  orders              Order[]
  entitlement         Entitlement?
  transactions        Transaction[]
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([storeId, status])
  @@index([customerId])
}

/// What a customer may download: granted by an order or a subscription. The
/// single rule for downloads: not revoked, and the release came out on or
/// before updatesUntil (null = lifetime).
model Entitlement {
  id             String        @id @default(cuid())
  storeId        String
  store          Store         @relation(fields: [storeId], references: [id])
  customerId     String
  customer       Customer      @relation(fields: [customerId], references: [id])
  productId      String
  product        Product       @relation(fields: [productId], references: [id])
  orderId        String?       @unique
  order          Order?        @relation(fields: [orderId], references: [id])
  subscriptionId String?       @unique
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  updatesUntil   DateTime?
  seats          Int           @default(1)
  revokedAt      DateTime?
  /// refund | dispute | admin
  revokeReason   String?
  licenseKeys    LicenseKey[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([storeId, createdAt])
  @@index([customerId])
  @@index([productId])
}

/// A licence key delivered with a purchase: issued by us (Product.issueLicenseKeys,
/// creemLicenseId null) or by Creem when its product has the licence key feature.
model LicenseKey {
  id              String      @id @default(cuid())
  entitlementId   String
  entitlement     Entitlement @relation(fields: [entitlementId], references: [id], onDelete: Cascade)
  creemLicenseId  String?     @unique
  key             String      @unique
  /// inactive | active | expired | disabled
  status          String
  activations     Int         @default(0)
  activationLimit Int?
  expiresAt       DateTime?
  mode            String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([entitlementId])
}

/// A money movement Creem recorded (payment, renewal, refund); the panel's Invoices.
/// Creem is the merchant of record and issues the invoice documents.
model Transaction {
  id                 String        @id @default(cuid())
  storeId            String
  store              Store         @relation(fields: [storeId], references: [id])
  customerId         String
  customer           Customer      @relation(fields: [customerId], references: [id])
  orderId            String?
  order              Order?        @relation(fields: [orderId], references: [id])
  subscriptionId     String?
  subscription       Subscription? @relation(fields: [subscriptionId], references: [id])
  creemTransactionId String        @unique
  mode               String
  /// Creem transaction type, e.g. payment
  type               String
  status             String
  amountCents        Int
  amountPaidCents    Int?
  taxCents           Int?
  discountCents      Int?
  refundedCents      Int?
  currency           String
  taxCountry         String?
  description        String?
  periodStart        DateTime?
  periodEnd          DateTime?
  /// When Creem created the transaction.
  occurredAt         DateTime
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([storeId, occurredAt])
  @@index([customerId])
}

model PaymentEvent {
  id          String   @id
  type        String
  mode        String
  processedAt DateTime @default(now())
}

/// Daily page-view counters for the public site, one row per slug per day.
/// Written fire-and-forget by the legacy page route and summarized on the
/// panel overview.
model PageViewDaily {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  date      DateTime @db.Date
  slug      String
  views     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([storeId, date, slug])
}

/// A message in one customer's account (new release, renewal reminder, …). `type` and `data`
/// are rendered in the reader's language by lib/notifications.ts; `dedupeKey` makes each
/// event fire once per user however often a webhook or the scheduled job repeats.
model Notification {
  id            String    @id @default(cuid())
  storeId       String
  store         Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          String
  data          Json
  /// Account path the message points to, e.g. /account/downloads.
  href          String?
  dedupeKey     String
  readAt        DateTime?
  /// pending | sent | skipped (opted out or no mail needed) | failed (gave up after retries)
  emailState    String    @default("pending")
  emailAttempts Int       @default(0)
  emailedAt     DateTime?
  createdAt     DateTime  @default(now())

  @@unique([userId, dedupeKey])
  @@index([userId, storeId, createdAt])
  @@index([userId, storeId, readAt])
  @@index([emailState, createdAt])
}

/// Which notification mails a customer wants. In-account messages are always kept; payment
/// problems are always mailed.
model NotificationPreference {
  userId        String   @id
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailReleases Boolean  @default(true)
  emailBilling  Boolean  @default(true)
  updatedAt     DateTime @updatedAt
}
