# Required: local or hosted PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cmsmotive?schema=public"

# Better Auth
# Use a long random value in production.
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
BETTER_AUTH_URL="http://localhost:3000"

# UploadThing (required for media uploads)
UPLOADTHING_TOKEN=""

# Plunk email delivery (required for verification, password reset, and contact mail)
PLUNK_SECRET_KEY=""
PLUNK_FROM_EMAIL=""
PLUNK_CONTACT_TO_EMAIL="hello@cmsmotive.de"

# OpenRouter (optional; enables AI features in the admin panel)
OPENROUTER_API_KEY=""

# Optional seed overrides. Development defaults are used when omitted.
SEED_SUPERADMIN_NAME="CMSMotive Superadmin"
SEED_SUPERADMIN_EMAIL="superadmin@cmsmotive.de"
SEED_SUPERADMIN_PASSWORD=""
SEED_ADMIN_NAME="CMSMotive Admin"
SEED_ADMIN_EMAIL="admin@cmsmotive.de"
SEED_ADMIN_PASSWORD=""
